# Copy to config.env (local). Source before batch runs.
LTX_ENDPOINT=
RUNPOD_API_KEY=

SERIES_DIR=/Users/ujwaltheja/AI/Main/Kids/series
OUT_SUBDIR=clips_from_full_visual_ltx25

# Export from Comfy: Templates → LTX-2.5 → Image-to-Video → Export (API)
WORKFLOW_API_JSON=workflows/ltx25_i2v_api.json

# After export, set Comfy node ids (strings) that this script will patch:
NODE_LOAD_IMAGE=
NODE_POSITIVE_PROMPT=

# Generation defaults (must match your workflow widgets)
WIDTH=768
HEIGHT=512
LENGTH=97
FPS=24

# Wordless kids — disable audio in workflow export when possible
GENERATE_AUDIO=false
